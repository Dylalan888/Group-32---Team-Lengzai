:root {
    --bg-base: #050505;
    --panel-bg: rgba(10, 15, 20, 0.85);
    --neon-cyan: #00f3ff;
    --neon-cyan-glow: rgba(0, 243, 255, 0.4);
    --neon-blue: #0066ff;
    --neon-red: #ff2a2a;
    --neon-red-glow: rgba(255, 42, 42, 0.4);
    --neon-green: #00ff66;
    --neon-warning: #ffb700;
    --text-main: #e0fbfc;
    --text-muted: #6b8a9c;
    
    --border-tech: 1px solid rgba(0, 243, 255, 0.2);
    --hud-font: 'Rajdhani', sans-serif;
    --body-font: 'Inter', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-base);
    color: var(--text-main);
    font-family: var(--body-font);
    height: 100vh;
    width: 100vw;
    overflow: hidden; /* No scrolling */
    background-image: 
        linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    background-position: center center;
}

/* Dashboard Wrapper - strict CSS Grid */
.dashboard-wrapper {
    display: grid;
    grid-template-columns: 240px 1fr;
    height: 100vh;
    width: 100vw;
    padding: 1rem;
    gap: 1rem;
}

/* Base Panel Style */
.ai-panel {
    background: var(--panel-bg);
    border: var(--border-tech);
    border-radius: 4px;
    position: relative;
    box-shadow: inset 0 0 20px rgba(0, 243, 255, 0.02);
}
.ai-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 10px; height: 10px;
    border-top: 2px solid var(--neon-cyan);
    border-left: 2px solid var(--neon-cyan);
}
.ai-panel::after {
    content: '';
    position: absolute;
    bottom: 0; right: 0;
    width: 10px; height: 10px;
    border-bottom: 2px solid var(--neon-cyan);
    border-right: 2px solid var(--neon-cyan);
}

/* Sidebar */
.sidebar {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
}

.brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 243, 255, 0.1);
    padding-bottom: 1rem;
}

.pulse-dot {
    width: 8px; height: 8px;
    background: var(--neon-cyan);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--neon-cyan);
    animation: pulse 2s infinite;
}

.brand h2 {
    font-family: var(--hud-font);
    font-size: 1.5rem;
    letter-spacing: 2px;
}
.brand span { color: var(--neon-cyan); }

.nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-family: var(--hud-font);
    font-size: 1.1rem;
    padding: 0.75rem;
    border: 1px solid transparent;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    letter-spacing: 1px;
}

.nav-links a:hover, .nav-links a.active {
    color: var(--neon-cyan);
    border: 1px solid var(--neon-cyan);
    background: rgba(0, 243, 255, 0.05);
    text-shadow: 0 0 5px var(--neon-cyan-glow);
}

.nav-links .icon { font-size: 1.2rem; }

.system-status {
    font-family: var(--hud-font);
    font-size: 0.9rem;
    color: var(--text-muted);
    border-top: 1px solid rgba(0, 243, 255, 0.1);
    padding-top: 1rem;
    line-height: 1.5;
}

.neon-cyan { color: var(--neon-cyan); text-shadow: 0 0 5px var(--neon-cyan); }
.neon-green { color: var(--neon-green); text-shadow: 0 0 5px var(--neon-green); }

/* Main Grid Area */
.main-grid {
    display: grid;
    grid-template-rows: 70px 100px 1fr 200px;
    gap: 1rem;
    height: calc(100vh - 2rem); /* Account for wrapper padding */
}

/* Header Row */
.header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1.5rem;
}
.hud-title h1 {
    font-family: var(--hud-font);
    font-size: 1.5rem;
    letter-spacing: 2px;
    margin-bottom: 0.1rem;
}
.hud-subtitle {
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 3px;
    font-family: var(--hud-font);
}
.hud-metrics {
    display: flex;
    gap: 1.5rem;
    align-items: center;
}
.metric-small {
    display: flex;
    flex-direction: column;
    text-align: right;
    font-family: var(--hud-font);
}
.metric-small label {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 1px;
}
.metric-small span {
    font-size: 1.1rem;
    font-weight: 700;
}
.user-chip {
    font-family: var(--hud-font);
    background: rgba(0, 243, 255, 0.1);
    border: 1px solid var(--neon-cyan);
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: var(--neon-cyan);
}

/* KPI Row */
.kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
}
.kpi-box {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.kpi-label {
    font-family: var(--hud-font);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-bottom: 0.25rem;
}
.kpi-value {
    font-family: var(--hud-font);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.5rem;
}
.kpi-value .unit { font-size: 1rem; color: var(--text-muted); }
.cyan { color: var(--neon-cyan); text-shadow: 0 0 10px var(--neon-cyan-glow); }
.red { color: var(--neon-red); text-shadow: 0 0 10px var(--neon-red-glow); }
.green { color: var(--neon-green); text-shadow: 0 0 10px rgba(0,255,102,0.4); }
.warning { color: var(--neon-warning); text-shadow: 0 0 10px rgba(255,183,0,0.4); }

.kpi-trend {
    font-family: var(--hud-font);
    font-size: 0.75rem;
    color: var(--neon-cyan);
    letter-spacing: 1px;
}
.kpi-trend.danger { color: var(--neon-red); }

/* Middle Row (Chart + Insights) */
.middle-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
    min-height: 0; /* Important for preventing overflow in flex/grid children */
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 243, 255, 0.1);
}
.panel-header h3 {
    font-family: var(--hud-font);
    font-size: 0.9rem;
    color: var(--neon-cyan);
    letter-spacing: 2px;
}

.graph-container {
    display: flex;
    flex-direction: column;
}
.tool-btn {
    font-family: var(--hud-font);
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--text-muted);
    color: var(--text-muted);
    cursor: pointer;
}
.tool-btn.active {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
}
.chart-wrapper {
    flex: 1;
    padding: 1rem;
    min-height: 0;
    position: relative;
}

.insights-container {
    display: flex;
    flex-direction: column;
}
.terminal-list {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}
/* Custom Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--neon-cyan); }

.terminal-item {
    font-family: var(--hud-font);
    border: 1px solid rgba(0,255,255,0.1);
    background: rgba(0,0,0,0.4);
    padding: 0.75rem;
}
.terminal-item.critical { border-color: var(--neon-red); }
.terminal-item.warning { border-color: var(--neon-warning); }
.terminal-item.success { border-color: var(--neon-green); }

.t-header {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.5rem;
    letter-spacing: 1px;
}
.critical .t-header { color: var(--neon-red); text-shadow: 0 0 5px var(--neon-red-glow); }
.warning .t-header { color: var(--neon-warning); }
.success .t-header { color: var(--neon-green); }

.t-body {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
}
.t-body strong { color: var(--text-main); }
.t-action {
    display: block;
    margin-top: 0.5rem;
    color: var(--neon-cyan);
    cursor: pointer;
}
.t-action:hover { text-decoration: underline; }

/* Bottom Row Data Table */
.bottom-row {
    display: flex;
    flex-direction: column;
}
.scanner-line {
    width: 100px;
    height: 2px;
    background: var(--neon-cyan);
    box-shadow: 0 0 10px var(--neon-cyan);
    animation: scan 3s infinite linear alternate;
}
@keyframes scan {
    0% { transform: translateX(0); }
    100% { transform: translateX(200px); }
}

.data-table-container {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
}

.ai-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--hud-font);
}
.ai-table th {
    text-align: left;
    padding: 0.5rem 1rem;
    color: var(--neon-cyan);
    font-size: 0.75rem;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(0,243,255,0.2);
    position: sticky;
    top: 0;
    background: var(--panel-bg);
    z-index: 10;
}
.ai-table td {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.ai-table tr:hover td {
    background: rgba(0, 243, 255, 0.05);
}

.sys-state {
    padding: 0.1rem 0.5rem;
    border: 1px solid;
    font-size: 0.7rem;
    letter-spacing: 1px;
}
.sys-state.nominal { color: var(--neon-green); border-color: var(--neon-green); }
.sys-state.alert { color: var(--neon-red); border-color: var(--neon-red); animation: flash 1.5s infinite; }
.sys-state.warn { color: var(--neon-warning); border-color: var(--neon-warning); }

@keyframes flash {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
}
@keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 243, 255, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 243, 255, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 243, 255, 0); }
}
